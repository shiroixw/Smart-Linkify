{
	"name": "smart-linkify",
	"version": "1.1.0",
	"description": "Smart Linkify – Instantly convert plain text URLs into clickable hyperlinks on any webpage",
	"author": "Smart Linkify Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/xiaowulang-turbo/Smart-Linkify.git"
	},
	"keywords": [
		"linkify",
		"chrome-extension",
		"url-converter",
		"hyperlink",
		"text-to-link",
		"browser-extension",
		"link-recognition",
		"auto-link"
	],
	"scripts": {
		"test": "node --test test/*.test.js",
		"pack": "echo \"Use Chrome Extensions page to pack the extension\"",
		"icons": "node scripts/generate-icons.js",
		"lint": "npx --yes eslint@9 .",
		"typecheck": "npx --yes tsc -p jsconfig.json",
		"prepare": "node scripts/install-hooks.js",
		"sync-version": "node scripts/sync-version.js",
		"version": "npm run sync-version && git add website/index.html extension/manifest.json README.md README.zh-CN.md"
	},
	"devDependencies": {},
	"dependencies": {},
	"engines": {
		"chrome": ">=88.0.0"
	},
	"homepage": "https://smart-linkify.vercel.app/",
	"bugs": {
		"url": "https://github.com/xiaowulang-turbo/Smart-Linkify/issues"
	}
}
