{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2022", "DOM"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["extension/lib/**/*.js"],
	"exclude": ["node_modules", "dist"]
}
